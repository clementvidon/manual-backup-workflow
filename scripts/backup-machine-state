#!/usr/bin/env bash

###############################################################################
# backup-machine-state
#
# Create a local recovery snapshot of system-level configuration.
#
# The backup includes /etc and package/service manifests useful to rebuild the
# machine. It may contain sensitive data and should be encrypted afterwards.
###############################################################################

set -euo pipefail
umask 077

usage() {
  echo "Usage: $(basename "$0") <output-directory>" >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 1
fi

output_root="$1"
run_id="$(date +%y%m%d-%H%M%S)"
backup_dir="$output_root/machine-state-$run_id"

mkdir -p "$backup_dir/manifests"
chmod 700 "$backup_dir"

echo "Creating machine state backup:"
echo "$backup_dir"

cat > "$backup_dir/INFO.md" <<EOF
# Machine State Backup $run_id

Created: $(date -Is)
Host: $(hostname)

This backup contains system-level configuration and package/service manifests.
It is not a full disk image and does not include user files.
It may contain sensitive data and should be encrypted afterwards.
EOF

echo
echo "[1/3] Saving package and service manifests"

apt-mark showmanual > "$backup_dir/manifests/apt-manual.txt" 2>/dev/null || true
dpkg --get-selections > "$backup_dir/manifests/dpkg-selections.txt" 2>/dev/null || true
snap list > "$backup_dir/manifests/snap-list.txt" 2>/dev/null || true
flatpak list --app > "$backup_dir/manifests/flatpak-apps.txt" 2>/dev/null || true

systemctl list-unit-files > "$backup_dir/manifests/systemd-system-units.txt" 2>/dev/null || true
systemctl --user list-unit-files > "$backup_dir/manifests/systemd-user-units.txt" 2>/dev/null || true

uname -a > "$backup_dir/manifests/uname.txt" 2>/dev/null || true
lsb_release -a > "$backup_dir/manifests/lsb-release.txt" 2>/dev/null || true

echo
echo "[2/3] Archiving /etc"

sudo tar -cpf "$backup_dir/etc.tar" -C / etc
sudo chown "$USER:$USER" "$backup_dir/etc.tar"
chmod 600 "$backup_dir/etc.tar"

echo
echo "[3/3] Writing checksums and summary"

sha256sum "$backup_dir/etc.tar" > "$backup_dir/SHA256SUMS.txt"
sha256sum -c "$backup_dir/SHA256SUMS.txt"

{
  echo
  echo "## Size"
  echo
  echo '```text'
  du -sh "$backup_dir"
  echo '```'
  echo
  echo "## Tree"
  echo
  echo '```text'
  find "$backup_dir" -maxdepth 3 -print | sort
  echo '```'
} >> "$backup_dir/INFO.md"

echo
echo "Done:"
echo "$backup_dir"
