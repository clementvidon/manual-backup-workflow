#!/usr/bin/env bash

###############################################################################
# backup
#
# Create one encrypted, verified backup from one target in a local output
# directory.
#
# The target is processed as follows:
# - check that enough local space is available
# - create a local .partial backup directory
# - write INFO.md
# - create and verify an encrypted .tar.age archive
# - write and verify SHA256SUMS.txt
# - rename the completed directory to its final name
#
# The completed backup remains local and can then be uploaded manually to
# remote backup storage.
###############################################################################

set -euo pipefail
umask 077

age_key_arg=""
output_dir=""

usage() {
  echo "Usage: backup --output-dir=<local-output-directory> [--path-to-age-key=<pass-path>] <target>" >&2
}

step() {
  echo
  echo "[$1/4] $2"
}

safe_name() {
  local parent
  local base

  parent="$(basename "$(dirname "$1")")"
  base="$(basename "$1")"

  printf '%s-%s' "$parent" "$base" \
    | sed 's/[^a-zA-Z0-9._-]/_/g'
}

format_bytes() {
  numfmt --to=iec-i --suffix=B "$1"
}

check_available_space() {
  local source="$1"
  local output="$2"

  local source_size_bytes
  local available_bytes
  local percentage_margin
  local minimum_margin
  local safety_margin
  local required_bytes

  minimum_margin=$((2 * 1024 * 1024 * 1024))

  source_size_bytes="$(
    du -sb --apparent-size "$source" |
      cut -f1
  )"

  available_bytes="$(
    df --output=avail -B1 "$output" |
      tail -n 1 |
      tr -d '[:space:]'
  )"

  percentage_margin=$((source_size_bytes / 10))

  if [ "$percentage_margin" -gt "$minimum_margin" ]; then
    safety_margin="$percentage_margin"
  else
    safety_margin="$minimum_margin"
  fi

  required_bytes=$((source_size_bytes + safety_margin))

  if [ "$available_bytes" -lt "$required_bytes" ]; then
    echo "Error: insufficient free space for backup." >&2
    echo >&2
    echo "Source:           $source" >&2
    echo "Output directory: $output" >&2
    echo "Source size:      $(format_bytes "$source_size_bytes")" >&2
    echo "Available space:  $(format_bytes "$available_bytes")" >&2
    echo "Required space:   $(format_bytes "$required_bytes")" >&2
    echo >&2
    echo "Required space includes a 10% safety margin, with a minimum margin of 2 GiB." >&2
    exit 1
  fi

  printf '%s' "$source_size_bytes"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --output-dir=*)
      output_dir="${1#--output-dir=}"
      shift
      ;;
    --output-dir)
      echo "Error: use --output-dir=<local-output-directory>" >&2
      exit 1
      ;;
    --path-to-age-key=*)
      age_key_arg="$1"
      shift
      ;;
    --path-to-age-key)
      echo "Error: use --path-to-age-key=<pass-path>" >&2
      exit 1
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -ne 1 ]; then
  usage
  exit 1
fi

if [ -z "$output_dir" ]; then
  echo "Error: missing required --output-dir=<local-output-directory>" >&2
  usage
  exit 1
fi

target="$1"

if [ ! -e "$target" ]; then
  echo "Error: target not found: $target" >&2
  exit 1
fi

target="$(realpath "$target")"

mkdir -p "$output_dir"
backup_output_dir="$(realpath "$output_dir")"

if [ ! -d "$backup_output_dir" ]; then
  echo "Error: output path is not a directory: $backup_output_dir" >&2
  exit 1
fi

if [ ! -w "$backup_output_dir" ]; then
  echo "Error: output directory is not writable: $backup_output_dir" >&2
  exit 1
fi

if ! encrypt_script="$(command -v encrypt-this)"; then
  echo "Error: encrypt-this is not installed or not in PATH." >&2
  exit 1
fi

source_size_bytes="$(check_available_space "$target" "$backup_output_dir")"
backup_size="$(format_bytes "$source_size_bytes")"

run_id="$(date +%y%m%d-%H%M%S)"
name="$(safe_name "$target")"

backup_name="$name-backup-$run_id"
final_backup="$backup_output_dir/$backup_name"
partial_backup="$backup_output_dir/$backup_name.partial"

info_file="$partial_backup/INFO.md"
checksum_file="$partial_backup/SHA256SUMS.txt"

if [ -e "$final_backup" ]; then
  echo "Error: completed backup already exists: $final_backup" >&2
  exit 1
fi

if [ -e "$partial_backup" ]; then
  echo "Error: partial backup already exists: $partial_backup" >&2
  echo "Remove it manually if it comes from an interrupted previous run." >&2
  exit 1
fi

step 1 "Prepare local backup for $target"

mkdir -p "$partial_backup"
cd "$partial_backup"

echo "Target:  $target"
echo "Working: $partial_backup"
echo "Final:   $final_backup"

step 2 "Write INFO.md"

{
  echo "# $backup_name"
  echo
  echo "Created: $(date -Is)"
  echo "Host: $(hostname)"
  echo "Run ID: $run_id"
  echo "Target: $target"
  echo
  echo "## Source size"
  echo
  echo '```text'
  echo "$backup_size"
  echo '```'
  echo
  echo "## Source tree"
  echo
  echo '```text'
  du -h --max-depth=3 "$target" | sort -h
  echo '```'
} > "$info_file"

step 3 "Create and verify encrypted archive"

if [ -n "$age_key_arg" ]; then
  bash "$encrypt_script" "$age_key_arg" "$target"
else
  bash "$encrypt_script" "$target"
fi

step 4 "Create checksums and finalize backup"

sha256sum ./*.tar.age | tee "$checksum_file"
sha256sum -c "$checksum_file"

{
  echo
  echo "## Encrypted archive SHA-256"
  echo
  echo '```text'
  cat "$checksum_file"
  echo '```'
} >> "$info_file"

cd "$backup_output_dir"
mv "$partial_backup" "$final_backup"

echo
echo "Completed backup:"
ls -lh "$final_backup"

echo
echo "Ready for manual upload:"
echo "$final_backup"
