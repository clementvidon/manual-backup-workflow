#!/usr/bin/env bash

###############################################################################
# encrypt-this
#
# Create a verified encrypted .tar.age archive from one file or directory.
#
# The archive is named from the target basename plus a timestamp. By default, it
# is created in the current working directory. Use --output-dir=<dir> to write it
# elsewhere. Original files are never modified.
#
# Encryption can use either:
# - age passphrase mode
# - an age key stored in pass, via --path-to-age-key=<pass-path>
###############################################################################

set -euo pipefail

age_key_path=""
output_dir=""

usage() {
  echo "Usage: encrypt-this [--path-to-age-key=<pass-path>] [--output-dir=<dir>] <file-or-directory>" >&2
}

beep() {
  if command -v paplay >/dev/null 2>&1; then
    paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || true
  else
    printf '\a' >/dev/tty 2>/dev/null || true
  fi
}

action_required() {
  beep
  echo "Action required: press Enter and unlock secret key"
  read -r _ </dev/tty
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --path-to-age-key=*)
      age_key_path="${1#--path-to-age-key=}"
      shift
      ;;
    --path-to-age-key)
      echo "Error: use --path-to-age-key=<pass-path>" >&2
      exit 1
      ;;
    --output-dir=*)
      output_dir="${1#--output-dir=}"
      shift
      ;;
    --output-dir)
      echo "Error: use --output-dir=<dir>" >&2
      exit 1
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -ne 1 ]; then
  usage
  exit 1
fi

target="${1%/}"

if [ ! -e "$target" ]; then
  echo "Error: not found: $target" >&2
  exit 1
fi

if ! command -v age >/dev/null 2>&1; then
  echo "Error: age is not installed." >&2
  exit 1
fi

if [ -n "$age_key_path" ]; then
  if ! command -v pass >/dev/null 2>&1; then
    echo "Error: pass is not installed." >&2
    exit 1
  fi

  if ! command -v age-keygen >/dev/null 2>&1; then
    echo "Error: age-keygen is not installed." >&2
    exit 1
  fi

  action_required
  if ! recipient="$(pass show "$age_key_path" | age-keygen -y /dev/stdin)"; then
    echo "Error: age key not found or could not be unlocked in pass: $age_key_path" >&2
    exit 1
  fi
fi

if [ -n "$output_dir" ]; then
  mkdir -p "$output_dir"
  workdir="$(realpath "$output_dir")"
else
  workdir="$(pwd -P)"
fi

if [ ! -d "$workdir" ] || [ ! -w "$workdir" ]; then
  echo "Error: output directory is not writable: $workdir" >&2
  exit 1
fi

target_abs="$(realpath "$target")"
parent="$(dirname "$target_abs")"
base="$(basename "$target_abs")"

run_id="$(date +%y%m%d-%H%M%S)"
archive="$workdir/$base-$run_id.tar.age"
tmp="$archive.tmp"

if [ -e "$archive" ] || [ -e "$tmp" ]; then
  echo "Error: archive already exists:" >&2
  echo "$archive" >&2
  exit 1
fi

echo "Archive: $archive"

if [ -n "$age_key_path" ]; then
  if ! tar -cf - -C "$parent" \
    --exclude="$base/$base-*.tar.age" \
    --exclude="$base/$base-*.tar.age.tmp" \
    "$base" \
  | age -r "$recipient" > "$tmp"; then
    rm -f "$tmp"
    echo "Error: archive creation failed." >&2
    exit 1
  fi
else
  if ! tar -cf - -C "$parent" \
    --exclude="$base/$base-*.tar.age" \
    --exclude="$base/$base-*.tar.age.tmp" \
    "$base" \
  | age -p > "$tmp"; then
    rm -f "$tmp"
    echo "Error: archive creation failed." >&2
    exit 1
  fi
fi

if [ ! -s "$tmp" ]; then
  rm -f "$tmp"
  echo "Error: archive was not created or is empty." >&2
  exit 1
fi

echo "Verifying..."

if [ -n "$age_key_path" ]; then
  action_required

  if ! age -d -i <(pass show "$age_key_path") "$tmp" | tar -tf - > /dev/null; then
    rm -f "$tmp"
    echo "Error: archive verification failed." >&2
    exit 1
  fi
else
  if ! age -d "$tmp" | tar -tf - > /dev/null; then
    rm -f "$tmp"
    echo "Error: archive verification failed." >&2
    exit 1
  fi
fi

mv "$tmp" "$archive"

echo "OK"
